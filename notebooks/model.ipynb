   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "from torchvision.models import mobilenet_v2\n",
    "\n",
    "def build_mobilenetv2_cifar(num_classes=10, width_mult=1.0, dropout=0.2, pretrained=False):\n",
    "    model = mobilenet_v2(weights='IMAGENET1K_V1' if pretrained else None,\n",
    "                          width_mult=width_mult)\n",
    "\n",
    "    # Adapt stem for 32x32 input: stride 2 -> 1\n",
    "    model.features[0][0].stride = (1, 1)\n",
    "\n",
    "    # Reduce one mid-stage downsample (recursive search this time)\n",
    "    for m in model.features[14].conv.modules():\n",
    "        if isinstance(m, nn.Conv2d) and m.stride == (2, 2):\n",
    "            m.stride = (1, 1)\n",
    "\n",
    "    model.classifier = nn.Sequential(\n",
    "        nn.Dropout(p=dropout),\n",
    "        nn.Linear(model.last_channel, num_classes)\n",
    "    )\n",
    "    return model\n",
    "\n",
    "model = build_mobilenetv2_cifar(num_classes=10, width_mult=1.0, dropout=0.2, pretrained=False)"
   ],
   "outputs": [],
   "execution_count": 5
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-07T19:53:20.261687Z",
